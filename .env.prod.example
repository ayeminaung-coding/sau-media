# Copy to .env on the DigitalOcean Droplet and replace every placeholder.
# This file is for docker-compose.prod.yml, which uses external services.

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@POSTGRES_HOST:5432/DATABASE
REDIS_URL=rediss://default:PASSWORD@REDIS_HOST:6379
LOG_LEVEL=INFO

# Set this to the image published by .github/workflows/publish-image.yml.
SAU_IMAGE=ghcr.io/OWNER/REPOSITORY:sha-COMMIT

# ---- Cloudflare R2 (S3-compatible) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sau-media
# Public hostname bound to the bucket. TikTok PULL_FROM_URL requires this
# domain to be verified in the TikTok developer portal.
R2_PUBLIC_BASE_URL=
TIKTOK_PULL_FROM_URL=false

# ---- Facebook ----
FACEBOOK_GRAPH_VERSION=v26.0
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# ---- TikTok ----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# Browser origin when the console is served from this Droplet on port 8080.
# Replace this IP if the Droplet address changes.
CORS_ORIGINS=["http://159.223.60.43:8080"]

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
#GEMINI_MODEL=gemini-2.5-flash

# https://openrouter.ai/keys -- reaches Gemini and most other models through a
# separate account and a different network path, which is the point of having
# it as the fallback.
OPENROUTER_API_KEY=
#OPENROUTER_MODEL=google/gemini-2.5-flash
# Optional attribution shown on OpenRouter's dashboards.
#OPENROUTER_REFERER=
#OPENROUTER_TITLE=Socials Auto Upload
