# How to obtain every value here: docs/CREDENTIALS.md

# ---- Core ----
DATABASE_URL=postgresql+psycopg://sau:sau@postgres:5432/sau
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO

# ---- Cloudflare R2 (S3-compatible) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sau-media
# Public base URL for the bucket. Either an r2.dev development URL or a
# custom domain. Lets Facebook download the video itself instead of being
# fed chunks -- the single biggest win for large files.
R2_PUBLIC_BASE_URL=

# ---- Facebook ----
FACEBOOK_GRAPH_VERSION=v21.0
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
# Long-lived Page access token. See docs/PLATFORM_NOTES.md for minting steps.
FACEBOOK_PAGE_ACCESS_TOKEN=

# ---- TikTok ----
# Let TikTok download the video from R2_PUBLIC_BASE_URL instead of pushing
# chunks. Requires a CUSTOM DOMAIN verified in the TikTok developer portal;
# an r2.dev URL cannot be verified. Leave false to use chunked upload.
TIKTOK_PULL_FROM_URL=false

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Seed values from the initial OAuth authorization; refreshed automatically.
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# ---- Caption generation (optional) ----
# Drafts the one line per episode that varies, for a series. Upstream of
# publishing: with none of this configured the caption templates still render,
# they just render without a hook, and nothing on the publish path changes.
#
# Two providers, tried in the order listed. A provider with no key is skipped,
# so configuring one and listing both is a valid setup -- the second serves
# when the first is down, rate limited, or refuses the prompt.
#CAPTION_PROVIDERS=["gemini","openrouter"]

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
#GEMINI_MODEL=gemini-2.5-flash

# https://openrouter.ai/keys -- reaches Gemini and most other models through a
# separate account and a different network path, which is the point of having
# it as the fallback.
OPENROUTER_API_KEY=
#OPENROUTER_MODEL=google/gemini-2.5-flash
# Optional attribution shown on OpenRouter's dashboards.
#OPENROUTER_REFERER=
#OPENROUTER_TITLE=Socials Auto Upload

# ---- Console ----
# Origins allowed to call the API from a browser, as a JSON list. The console
# is a separate origin, so it must be listed here or every request is blocked
# by the preflight. Defaults to http://localhost:8080, the nginx console; add
# http://localhost:5173 as well when working against `npm run dev`, which
# serves from its own origin.
# This list is also the R2 bucket's CORS policy: the browser PUTs the video
# straight to R2, so after changing it run `python scripts/init_r2_cors.py`
# or the upload still fails at the bucket, one hop later.
#CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]
# Where the BROWSER reaches the API. Baked into the console bundle at build
# time by docker compose; overridable per browser from the Endpoint panel.
#CONSOLE_API_BASE_URL=http://localhost:8001

# ---- Tuning (optional) ----
# Upload chunk size for the push fallback paths. Must stay inside TikTok's
# 5 MiB minimum / 64 MiB maximum window.
#CHUNK_SIZE_BYTES=16777216
