{
  "name": "SAU — Daily Post",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 9,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Daily 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-160, 300]
    },
    {
      "parameters": {
        "url": "http://api:8000/schedule?limit=1",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Next In Backlog",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [60, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-has-asset",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              },
              "leftValue": "={{ $json.asset_id }}",
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Anything Queued?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [280, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://api:8000/assets/{{ $json.asset_id }}/release",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Release Asset",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 200]
    },
    {
      "parameters": {
        "amount": 4,
        "unit": "minutes"
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Wait For Transcode",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [720, 200],
      "webhookId": "b1000000-0000-4000-8000-000000000005"
    },
    {
      "parameters": {
        "url": "=http://api:8000/assets/{{ $json.asset_id }}/jobs",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Check Result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 200]
    },
    {
      "parameters": {
        "jsCode": "// One item in, one summary out. Jobs are independent, so a mixed result is\n// normal and must not be collapsed into a single pass/fail.\nconst jobs = $input.all().map((i) => i.json);\nconst failed = jobs.filter((j) => j.state === 'failed');\nconst pending = jobs.filter((j) => !['published', 'failed'].includes(j.state));\n\nreturn [{\n  json: {\n    ok: failed.length === 0,\n    published: jobs.filter((j) => j.state === 'published').map((j) => j.platform),\n    failed: failed.map((j) => ({ platform: j.platform, error: j.last_error })),\n    still_running: pending.map((j) => j.platform),\n    summary: `${jobs.length - failed.length - pending.length}/${jobs.length} published`\n      + (failed.length ? `, ${failed.length} failed: ` + failed.map((j) => `${j.platform} — ${j.last_error}`).join('; ') : '')\n      + (pending.length ? `, ${pending.length} still running` : ''),\n  },\n}];"
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Summarise",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1160, 200]
    },
    {
      "parameters": {
        "jsCode": "// Nothing to post. Worth a notification: silence here is indistinguishable\n// from the workflow being switched off.\nreturn [{ json: { ok: false, summary: 'Backlog is empty — nothing was posted today.' } }];"
      },
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "Backlog Empty",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 420]
    }
  ],
  "connections": {
    "Daily 09:00": {
      "main": [[{ "node": "Next In Backlog", "type": "main", "index": 0 }]]
    },
    "Next In Backlog": {
      "main": [[{ "node": "Anything Queued?", "type": "main", "index": 0 }]]
    },
    "Anything Queued?": {
      "main": [
        [{ "node": "Release Asset", "type": "main", "index": 0 }],
        [{ "node": "Backlog Empty", "type": "main", "index": 0 }]
      ]
    },
    "Release Asset": {
      "main": [[{ "node": "Wait For Transcode", "type": "main", "index": 0 }]]
    },
    "Wait For Transcode": {
      "main": [[{ "node": "Check Result", "type": "main", "index": 0 }]]
    },
    "Check Result": {
      "main": [[{ "node": "Summarise", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Bangkok"
  },
  "pinData": {}
}
